# Copy to .env. Never commit .env.
FACILITATOR_PASSWORD=change-me        # if unset, a random one is printed at startup
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/meridian.sqlite3
CONTENT_DIR=content
ROUND_SECONDS=1200
READING_SECONDS=180
# Comma-separated allowed browser origins for cross-origin use (empty = same-origin only)
ALLOWED_ORIGINS=
# Reserved for the staff-message milestone:
ANTHROPIC_API_KEY=your-key-here
